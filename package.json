{
	"name": "dsh-inkpond",
	"version": "0.3.5",
	"description": "Interactive Chinese ink-wash backgrounds for DeepSeek Harness: lotus pond, misty hills, Qingming handscroll, 24 solar terms, Northern sea and Big fat whale.",
	"type": "module",
	"license": "MIT",
	"author": "Shin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shin4/inkpond-dsh.git"
	},
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"inkpond",
		"theme",
		"canvas"
	],
	"engines": {
		"node": ">=22",
		"dsh": ">=0.2.1-rc.3"
	},
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude \".local/**\"",
		"check": "npm run typecheck && npm test && npm run build",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5 || ~4.1.0"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "4.0.5",
		"@tabler/icons-react": "3.50.0",
		"@types/node": "24.10.1",
		"@types/react": "18.3.27",
		"@types/react-dom": "18.3.7",
		"esbuild": "0.25.12",
		"inkpond": "file:vendor/inkpond-4cb32fb.tgz",
		"jsdom": "26.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	}
}
